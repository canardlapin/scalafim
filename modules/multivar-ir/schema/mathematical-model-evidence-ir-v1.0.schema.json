{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalafim.org/schema/mathematical-model-evidence-ir-v1.0.schema.json",
  "title": "ScalaFIM mathematical model evidence IR 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "models"],
  "properties": {
    "schema": {"const": "scalafim-mathematical-model-evidence-ir/1.0"},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    }
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1},
    "nonnegative": {"type": "number", "minimum": 0},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"$ref": "#/$defs/nonnegative"},
        "relative": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contract_id",
        "family",
        "estimand",
        "operator_program_schema",
        "program_id",
        "data_identity",
        "mask",
        "losses",
        "geometries",
        "penalties",
        "assumptions",
        "solver",
        "achieved_guarantee",
        "certificate_identities",
        "reproducibility"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "contract_id": {"$ref": "#/$defs/identity"},
        "family": {
          "enum": [
            "anchor_regularized_frame",
            "exact_spectral_frame",
            "joint_sparse_functional_factorization",
            "generalized_low_rank_model",
            "convexified_low_rank_matrix",
            "structured_multiblock_factorization"
          ]
        },
        "estimand": {
          "enum": [
            "anchor_coefficient_refinement",
            "generalized_spectral_subspace",
            "joint_structured_factors",
            "generalized_latent_representation",
            "convex_low_rank_matrix",
            "shared_block_latent_representation"
          ]
        },
        "operator_program_schema": {"const": "scalafim-operator-program-ir/0.2"},
        "program_id": {"$ref": "#/$defs/identity"},
        "data_identity": {"$ref": "#/$defs/identity"},
        "mask": {"$ref": "#/$defs/mask"},
        "losses": {"type": "array", "items": {"$ref": "#/$defs/loss_binding"}},
        "geometries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometry"}},
        "penalties": {"type": "array", "items": {"$ref": "#/$defs/penalty"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
        "solver": {"$ref": "#/$defs/solver"},
        "achieved_guarantee": {"$ref": "#/$defs/guarantee"},
        "certificate_identities": {"type": "array", "items": {"$ref": "#/$defs/identity"}, "uniqueItems": true},
        "reproducibility": {"$ref": "#/$defs/reproducibility"}
      }
    },
    "loss_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_domain_identity", "loss"],
      "properties": {
        "feature_domain_identity": {"$ref": "#/$defs/identity"},
        "loss": {"$ref": "#/$defs/loss"}
      }
    },
    "loss": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "half_squared"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "delta"], "properties": {"kind": {"const": "huber"}, "delta": {"$ref": "#/$defs/positive"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "bernoulli_logistic"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "poisson_log_link"}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "levels", "order_identity"],
          "properties": {
            "kind": {"const": "cumulative_ordinal"},
            "levels": {"type": "integer", "minimum": 2},
            "order_identity": {"$ref": "#/$defs/identity"}
          }
        },
        {"type": "object", "additionalProperties": false, "required": ["kind", "levels"], "properties": {"kind": {"const": "softmax"}, "levels": {"type": "integer", "minimum": 2}}}
      ]
    },
    "missingness": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "fixed_mask"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "generator_identity"], "properties": {"kind": {"const": "mcar_simulation"}, "generator_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "mechanism_identity"], "properties": {"kind": {"const": "mar_sensitivity"}, "mechanism_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "selection_model_identity"], "properties": {"kind": {"const": "mnar_sensitivity"}, "selection_model_identity": {"$ref": "#/$defs/identity"}}}
      ]
    },
    "mask": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "observation_identity"],
          "properties": {"kind": {"const": "complete"}, "observation_identity": {"$ref": "#/$defs/identity"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mask_identity", "observed_count", "target"],
          "properties": {
            "kind": {"const": "explicit"},
            "mask_identity": {"$ref": "#/$defs/identity"},
            "observed_count": {"type": "integer", "minimum": 1},
            "target": {"$ref": "#/$defs/missingness"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mask_identity", "observed_count", "likelihood_identity", "target"],
          "properties": {
            "kind": {"const": "censored"},
            "mask_identity": {"$ref": "#/$defs/identity"},
            "observed_count": {"type": "integer", "minimum": 1},
            "likelihood_identity": {"$ref": "#/$defs/identity"},
            "target": {"$ref": "#/$defs/missingness"}
          }
        }
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "operator_identity", "certificate_identity"],
      "properties": {
        "role": {"enum": ["row_normalization", "column_normalization", "smoothness", "graph", "block_alignment"]},
        "operator_identity": {"$ref": "#/$defs/identity"},
        "certificate_identity": {"$ref": "#/$defs/identity"}
      }
    },
    "penalty_owner": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["row_factor", "column_factor", "shared_rows", "convex_matrix"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "block_identity"], "properties": {"kind": {"const": "block_decoder"}, "block_identity": {"$ref": "#/$defs/identity"}}}
      ]
    },
    "penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "functional", "weight", "operator_identity"],
      "properties": {
        "owner": {"$ref": "#/$defs/penalty_owner"},
        "functional": {"enum": ["l1", "group_l21", "sparse_group", "total_variation", "squared_smoothness", "nuclear_norm", "squared_frobenius"]},
        "weight": {"$ref": "#/$defs/positive"},
        "operator_identity": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theorem_id", "assumption_id", "witness_identity"],
      "properties": {
        "theorem_id": {"$ref": "#/$defs/identity"},
        "assumption_id": {"$ref": "#/$defs/identity"},
        "witness_identity": {"$ref": "#/$defs/identity"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "implementation_version", "policy_identity", "trace_identity", "tolerance", "iteration_count"],
      "properties": {
        "family": {"enum": ["exact_spectral", "convex_composite", "alternating_block_coordinate", "palm", "convex_nuclear"]},
        "implementation_version": {"$ref": "#/$defs/identity"},
        "policy_identity": {"$ref": "#/$defs/identity"},
        "trace_identity": {"$ref": "#/$defs/identity"},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "iteration_count": {"type": "integer", "minimum": 0}
      }
    },
    "guarantee": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "certificate_identity"], "properties": {"kind": {"const": "exact_global"}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "gap", "certificate_identity"], "properties": {"kind": {"const": "epsilon_global"}, "gap": {"$ref": "#/$defs/nonnegative"}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "distance_bound", "certificate_identity"], "properties": {"kind": {"const": "unique_minimizer"}, "distance_bound": {"$ref": "#/$defs/nonnegative"}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "residual", "certificate_identity"], "properties": {"kind": {"const": "stationary"}, "residual": {"$ref": "#/$defs/nonnegative"}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "residuals", "certificate_identity"], "properties": {"kind": {"const": "coordinatewise_stationary"}, "residuals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonnegative"}}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "residual", "certificate_identity"], "properties": {"kind": {"const": "feasible"}, "residual": {"$ref": "#/$defs/nonnegative"}, "certificate_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "reason"], "properties": {"kind": {"const": "unresolved"}, "reason": {"$ref": "#/$defs/identity"}}}
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"$ref": "#/$defs/identity"}, "version": {"$ref": "#/$defs/identity"}}
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_identity", "seed", "dependencies", "condition_estimate", "tolerance", "result_identity"],
      "properties": {
        "generator_identity": {"$ref": "#/$defs/identity"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependency"}},
        "condition_estimate": {"type": "number", "minimum": 1},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "result_identity": {"$ref": "#/$defs/identity"}
      }
    }
  }
}
