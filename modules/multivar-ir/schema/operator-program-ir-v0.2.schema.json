{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalafim.org/schema/operator-program-ir-v0.2.schema.json",
  "title": "ScalaFIM operator program IR 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spaces", "operators", "programs", "rewrites", "fits", "operator_policies", "composite_lowerings", "projections", "synthesis_capabilities"],
  "properties": {
    "schema": {"const": "scalafim-operator-program-ir/0.2"},
    "spaces": {"type": "array", "items": {"$ref": "#/$defs/space"}},
    "operators": {"type": "array", "items": {"$ref": "#/$defs/operator"}},
    "programs": {"type": "array", "items": {"$ref": "#/$defs/program"}},
    "rewrites": {"type": "array", "items": {"$ref": "#/$defs/rewrite"}},
    "fits": {"type": "array", "items": {"$ref": "#/$defs/fit"}},
    "operator_policies": {"type": "array", "items": {"$ref": "#/$defs/operatorPolicy"}},
    "composite_lowerings": {"type": "array", "items": {"$ref": "#/$defs/compositeLowering"}},
    "projections": {"type": "array", "items": {"$ref": "#/$defs/projection"}},
    "synthesis_capabilities": {"type": "array", "items": {"$ref": "#/$defs/synthesisCapability"}}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1},
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "dimension"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "role": {"enum": ["samples", "observed", "latent", "kernel", "block"]},
        "dimension": {"type": "integer", "minimum": 1}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space_id", "variance"],
      "properties": {
        "space_id": {"$ref": "#/$defs/identity"},
        "variance": {"enum": ["primal", "dual"]}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value_identity", "tolerance", "norm", "method", "precision", "backend", "regularization", "residual"],
      "properties": {
        "property": {"$ref": "#/$defs/identity"},
        "value_identity": {"$ref": "#/$defs/identity"},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "norm": {"$ref": "#/$defs/identity"},
        "method": {"$ref": "#/$defs/identity"},
        "precision": {"$ref": "#/$defs/identity"},
        "backend": {"$ref": "#/$defs/identity"},
        "regularization": {"type": ["string", "null"]},
        "residual": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["source", "adapted", "derived", "certified", "unsafe_assumption"]},
        "label": {"type": "string"},
        "adapter": {"type": "string"},
        "operation": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "property": {"type": "string"},
        "method": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "codomain", "role", "evidence", "representation", "gauge", "derivation", "value_identity", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "domain": {"$ref": "#/$defs/coordinate"},
        "codomain": {"$ref": "#/$defs/coordinate"},
        "role": {"type": "object", "required": ["kind"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "certificates"],
          "properties": {
            "status": {"enum": ["unchecked", "certified", "assumed"]},
            "certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}}
          }
        },
        "representation": {"enum": ["dense", "sparse", "diagonal", "block", "low_rank", "kronecker", "lazy_affine", "matrix_free"]},
        "gauge": {"type": "object", "required": ["kind"]},
        "derivation": {"type": "object", "required": ["kind"]},
        "value_identity": {"$ref": "#/$defs/identity"},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "operatorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "input_operators", "output_operators", "selection", "scale_matching", "scope", "preservation", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "kind": {"type": "object", "required": ["kind"]},
        "input_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "output_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "selection": {"type": "object", "required": ["kind"]},
        "scale_matching": {"type": "object", "required": ["kind"]},
        "scope": {"enum": ["single_operator", "joint_system", "blockwise_unsafe"]},
        "preservation": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind"]}},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "compositeLowering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "program_id", "term", "target_operator", "method", "available_capabilities", "auxiliary", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "program_id": {"$ref": "#/$defs/identity"},
        "term": {"type": "object", "required": ["kind", "index"]},
        "target_operator": {"$ref": "#/$defs/identity"},
        "method": {"enum": ["primal_dual", "admm", "augmented_lagrangian", "conic"]},
        "available_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["primal_dual", "admm", "augmented_lagrangian", "conic"]}
        },
        "auxiliary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["variable_id", "target", "equation"],
          "properties": {
            "variable_id": {"$ref": "#/$defs/identity"},
            "target": {"type": "object", "required": ["parameter_id", "capability", "operation"]},
            "equation": {"type": "object", "required": ["kind"]}
          }
        },
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "result", "equivalence", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "action": {"$ref": "#/$defs/projectionAction"},
        "result": {"$ref": "#/$defs/projectionResult"},
        "equivalence": {"type": "object", "required": ["kind"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "projectionAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "analysis_frame", "feature_schema"],
          "properties": {
            "kind": {"const": "full_projection"},
            "analysis_frame": {"$ref": "#/$defs/identity"},
            "feature_schema": {"$ref": "#/$defs/identity"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "analysis_frame", "source_schema", "selected_features"],
          "properties": {
            "kind": {"const": "partial_contribution"},
            "analysis_frame": {"$ref": "#/$defs/identity"},
            "source_schema": {"$ref": "#/$defs/identity"},
            "selected_features": {"$ref": "#/$defs/nonemptyNames"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "analysis_frame", "source_schema", "selected_features", "metric_kind", "metric_dimension", "ridge"],
          "properties": {
            "kind": {"const": "partial_least_squares"},
            "analysis_frame": {"$ref": "#/$defs/identity"},
            "source_schema": {"$ref": "#/$defs/identity"},
            "selected_features": {"$ref": "#/$defs/nonemptyNames"},
            "metric_kind": {"$ref": "#/$defs/metricKind"},
            "metric_dimension": {"type": "integer", "minimum": 1},
            "ridge": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "supplementary_table", "fitted_scores", "fitted_rows", "source_components", "convention"],
          "properties": {
            "kind": {"const": "supplementary_variables"},
            "supplementary_table": {"$ref": "#/$defs/identity"},
            "fitted_scores": {"$ref": "#/$defs/identity"},
            "fitted_rows": {"$ref": "#/$defs/identity"},
            "source_components": {"$ref": "#/$defs/nonemptyIndices"},
            "convention": {"$ref": "#/$defs/supplementaryConvention"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "analysis_frame", "decoder", "source", "components", "target_features", "coordinate"],
          "properties": {
            "kind": {"const": "reconstruction"},
            "analysis_frame": {"$ref": "#/$defs/identity"},
            "decoder": {"$ref": "#/$defs/identity"},
            "source": {"$ref": "#/$defs/reconstructionSource"},
            "components": {"$ref": "#/$defs/nonemptyIndices"},
            "target_features": {"$ref": "#/$defs/nonemptyNames"},
            "coordinate": {"$ref": "#/$defs/reconstructionCoordinate"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "estimand", "source_space", "target_space", "source_frame", "target_decoder", "scaling"],
          "properties": {
            "kind": {"const": "paired_transfer"},
            "estimand": {"enum": ["Plsc", "Cca"]},
            "source_space": {"$ref": "#/$defs/identity"},
            "target_space": {"$ref": "#/$defs/identity"},
            "source_frame": {"$ref": "#/$defs/identity"},
            "target_decoder": {"$ref": "#/$defs/identity"},
            "scaling": {"$ref": "#/$defs/identity"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "block", "global_frame", "local_frame", "block_schema"],
          "properties": {
            "kind": {"const": "multiblock_scores"},
            "block": {"$ref": "#/$defs/identity"},
            "global_frame": {"$ref": "#/$defs/identity"},
            "local_frame": {"$ref": "#/$defs/identity"},
            "block_schema": {"$ref": "#/$defs/identity"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "block", "global_frame", "local_frame", "block_schema", "combination_weight"],
          "properties": {
            "kind": {"const": "multiblock_contribution"},
            "block": {"$ref": "#/$defs/identity"},
            "global_frame": {"$ref": "#/$defs/identity"},
            "local_frame": {"$ref": "#/$defs/identity"},
            "block_schema": {"$ref": "#/$defs/identity"},
            "combination_weight": {"type": "number"}
          }
        }
      ]
    },
    "projectionResult": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["scores", "functional_frame", "transfer_values"]}}},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "coordinate"],
          "properties": {
            "kind": {"const": "feature_values"},
            "coordinate": {"$ref": "#/$defs/reconstructionCoordinate"}
          }
        }
      ]
    },
    "synthesisCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "analysis_frame", "decoder", "policy", "supports_working_coordinates", "supports_original_coordinates", "supports_component_selection", "supports_feature_selection", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "analysis_frame": {"$ref": "#/$defs/identity"},
        "decoder": {"$ref": "#/$defs/identity"},
        "policy": {"$ref": "#/$defs/synthesisPolicy"},
        "supports_working_coordinates": {"type": "boolean"},
        "supports_original_coordinates": {"type": "boolean"},
        "supports_component_selection": {"type": "boolean"},
        "supports_feature_selection": {"type": "boolean"},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "synthesisPolicy": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "decoder_identity"], "properties": {"kind": {"const": "explicit"}, "decoder_identity": {"$ref": "#/$defs/identity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "tolerance"], "properties": {"kind": {"const": "orthonormal_transpose"}, "tolerance": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "ridge"], "properties": {"kind": {"const": "euclidean_least_squares"}, "ridge": {"type": "number", "minimum": 0}}}
      ]
    },
    "supplementaryConvention": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "null_policy"], "properties": {"kind": {"const": "multivarious_covariance_scaled"}, "null_policy": {"$ref": "#/$defs/nullComponentPolicy"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "measure_identity", "centering", "null_policy"], "properties": {"kind": {"const": "metric_least_squares"}, "measure_identity": {"$ref": "#/$defs/identity"}, "centering": {"$ref": "#/$defs/identity"}, "null_policy": {"$ref": "#/$defs/nullComponentPolicy"}}}
      ]
    },
    "nullComponentPolicy": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "tolerance"], "properties": {"kind": {"enum": ["reject", "drop"]}, "tolerance": {"type": "number", "minimum": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "ridge"], "properties": {"kind": {"const": "regularize"}, "ridge": {"type": "number", "minimum": 0}}}
      ]
    },
    "reconstructionSource": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["supplied_scores", "full_projection", "partial_contribution"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "metric_kind", "metric_dimension", "ridge"], "properties": {"kind": {"const": "partial_least_squares"}, "metric_kind": {"$ref": "#/$defs/metricKind"}, "metric_dimension": {"type": "integer", "minimum": 1}, "ridge": {"type": "number", "minimum": 0}}}
      ]
    },
    "reconstructionCoordinate": {"enum": ["working", "original"]},
    "metricKind": {"enum": ["identity", "diagonal", "dense_symmetric", "sparse_symmetric"]},
    "nonemptyNames": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}},
    "nonemptyIndices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameters", "objective", "normalizations", "penalties", "constraints", "result", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "parameters": {"type": "array", "minItems": 1},
        "objective": {"type": "object", "required": ["kind"]},
        "normalizations": {"type": "array"},
        "penalties": {"type": "array"},
        "constraints": {"type": "array"},
        "result": {"type": "object", "required": ["equivalence", "representative", "guarantee"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "original_program_id", "lowered_program_id", "rule", "input_operators", "output_operators", "proof", "remaining_equivalence", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "original_program_id": {"$ref": "#/$defs/identity"},
        "lowered_program_id": {"$ref": "#/$defs/identity"},
        "rule": {"enum": ["exact_linear_reduction", "support_restriction", "quadratic_pullback", "generalized_to_standard_eigen", "whitening"]},
        "input_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "output_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "proof": {"$ref": "#/$defs/certificate"},
        "remaining_equivalence": {"type": "object", "required": ["kind"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "frames", "objective_value", "retained_rank", "spectral_clusters", "residual_certificates", "solver_guarantee", "remaining_equivalence", "provenance"],
      "properties": {
        "program_id": {"$ref": "#/$defs/identity"},
        "frames": {"type": "array"},
        "objective_value": {"type": "number"},
        "retained_rank": {"type": "integer", "minimum": 0},
        "spectral_clusters": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
        "residual_certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}},
        "solver_guarantee": {"enum": ["global_spectral_optimum", "global_convex_optimum", "stationary_point", "feasible_point", "coordinatewise_stationary", "locally_optimal", "heuristic_feasible", "unresolved"]},
        "remaining_equivalence": {"type": "object", "required": ["kind"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    }
  }
}
