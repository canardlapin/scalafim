{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalafim.org/schema/operator-program-ir-v0.2.schema.json",
  "title": "ScalaFIM operator program IR 0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spaces", "operators", "programs", "rewrites", "fits"],
  "properties": {
    "schema": {"const": "scalafim-operator-program-ir/0.2"},
    "spaces": {"type": "array", "items": {"$ref": "#/$defs/space"}},
    "operators": {"type": "array", "items": {"$ref": "#/$defs/operator"}},
    "programs": {"type": "array", "items": {"$ref": "#/$defs/program"}},
    "rewrites": {"type": "array", "items": {"$ref": "#/$defs/rewrite"}},
    "fits": {"type": "array", "items": {"$ref": "#/$defs/fit"}}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1},
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "dimension"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "role": {"enum": ["samples", "observed", "latent", "kernel", "block"]},
        "dimension": {"type": "integer", "minimum": 1}
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["space_id", "variance"],
      "properties": {
        "space_id": {"$ref": "#/$defs/identity"},
        "variance": {"enum": ["primal", "dual"]}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {"type": "number", "minimum": 0},
        "relative": {"type": "number", "minimum": 0}
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "value_identity", "tolerance", "norm", "method", "precision", "backend", "regularization", "residual"],
      "properties": {
        "property": {"$ref": "#/$defs/identity"},
        "value_identity": {"$ref": "#/$defs/identity"},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "norm": {"$ref": "#/$defs/identity"},
        "method": {"$ref": "#/$defs/identity"},
        "precision": {"$ref": "#/$defs/identity"},
        "backend": {"$ref": "#/$defs/identity"},
        "regularization": {"type": ["string", "null"]},
        "residual": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["source", "adapted", "derived", "certified", "unsafe_assumption"]},
        "label": {"type": "string"},
        "adapter": {"type": "string"},
        "operation": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "property": {"type": "string"},
        "method": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domain", "codomain", "role", "evidence", "representation", "gauge", "derivation", "value_identity", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "domain": {"$ref": "#/$defs/coordinate"},
        "codomain": {"$ref": "#/$defs/coordinate"},
        "role": {"type": "object", "required": ["kind"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "certificates"],
          "properties": {
            "status": {"enum": ["unchecked", "certified", "assumed"]},
            "certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}}
          }
        },
        "representation": {"enum": ["dense", "sparse", "diagonal", "block", "low_rank", "kronecker", "lazy_affine", "matrix_free"]},
        "gauge": {"type": "object", "required": ["kind"]},
        "derivation": {"type": "object", "required": ["kind"]},
        "value_identity": {"$ref": "#/$defs/identity"},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameters", "objective", "normalizations", "penalties", "constraints", "result", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "parameters": {"type": "array", "minItems": 1},
        "objective": {"type": "object", "required": ["kind"]},
        "normalizations": {"type": "array"},
        "penalties": {"type": "array"},
        "constraints": {"type": "array"},
        "result": {"type": "object", "required": ["equivalence", "representative", "guarantee"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "rewrite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "original_program_id", "lowered_program_id", "rule", "input_operators", "output_operators", "proof", "remaining_equivalence", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/identity"},
        "original_program_id": {"$ref": "#/$defs/identity"},
        "lowered_program_id": {"$ref": "#/$defs/identity"},
        "rule": {"enum": ["exact_linear_reduction", "support_restriction", "generalized_to_standard_eigen", "whitening"]},
        "input_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "output_operators": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
        "proof": {"$ref": "#/$defs/certificate"},
        "remaining_equivalence": {"type": "object", "required": ["kind"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "frames", "objective_value", "retained_rank", "spectral_clusters", "residual_certificates", "solver_guarantee", "remaining_equivalence", "provenance"],
      "properties": {
        "program_id": {"$ref": "#/$defs/identity"},
        "frames": {"type": "array"},
        "objective_value": {"type": "number"},
        "retained_rank": {"type": "integer", "minimum": 0},
        "spectral_clusters": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
        "residual_certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}},
        "solver_guarantee": {"enum": ["global_spectral_optimum", "global_convex_optimum", "stationary_point", "feasible_point"]},
        "remaining_equivalence": {"type": "object", "required": ["kind"]},
        "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}}
      }
    }
  }
}
