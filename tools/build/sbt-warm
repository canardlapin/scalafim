#!/usr/bin/env python3
"""Run sbt commands against a warm, per-worktree sbt server.

Why: a cold `sbt <task>` spends ~95% of a typical gate loading the build (about
60 s on a shared host) and, with the shared global staging directory, needs a
host-wide lock. This wrapper instead gives every worktree its own sbt global
base (so nothing mutable is shared between worktrees and no global lock is
needed), seeds that base from a copy-on-write clone of a template built for the
same dependency pins, and keeps one resident sbt server per worktree reached
through `sbt --client`, so repeat gates cost about a second.

usage:
  python3 tools/build/sbt-warm [--] 'mvpaFmriJVM/test' 'mvpaFmriJS/test'   run commands, in order
  python3 tools/build/sbt-warm --status                          show this worktree's base/server
  python3 tools/build/sbt-warm --shutdown                        stop this worktree's server
  python3 tools/build/sbt-warm --gc [--apply]                    list (or delete) orphaned bases
  python3 tools/build/sbt-warm --gc-templates                    list eligible template snapshots
  python3 tools/build/sbt-warm --gc-templates --apply --custody-root DIR --volume-uuid UUID
                                                               remove only verified externally-custodied templates
  python3 tools/build/sbt-warm -h | --help                       show this help

Commands run in order; the first failing command stops the run with its exit
code. A zero client exit also requires a fresh completion receipt written by
the server after that command; a disconnected client cannot report success.
Commands that terminate sbt before writing the receipt fail this check; use
`--shutdown` to stop the server. Arguments starting with `-` are rejected unless
they follow `--`.

A base is never deleted because the dependency pins changed: sbt's staging
directory is keyed by source URI (which includes the revision), so a base stays
valid across pin bumps and only accumulates disk, which `--gc` reclaims for
removed worktrees. Pins (every 40-hex SHA and canardlapin repository in
build.sbt, plus project/build.properties and project/plugins.sbt) select the
template that seeds a new base; the key is recorded in `.pin-key-v2`.
`.pin-key` keeps the pre-2026-10-04 key so older copies of this script, which
delete a base whose `.pin-key` differs, leave bases touched by this one alone.

Every run holds a shared per-worktree lock. `--shutdown`, and `--gc --apply`
for each base it deletes, need that lock exclusively and refuse while commands
are running. `--shutdown` stops the server named by project/target/active.json;
if that file is missing or stale but a socket in the base answers, it is
repointed at that socket first.

Cold startup holds that lock exclusively until its first command returns and
a usable server can be recorded. Warm runs share the lock. A live server must
match the requested heap, processor count and idle timeout; otherwise commands
refuse before modifying its base. Run `--shutdown`, then rerun with the desired
environment. `--status` shows the requested launch values and the recorded
startup values; these are not measurements of effective JVM flags.
If a server dies after the reuse check, sbt may restart it while the run still
holds a shared lock. Its changed socket identity makes the next reuse check
refuse; the startup record does not prove such a restart's launch values.

`--gc` only considers bases that record their worktree (`.worktree`), whose
worktree directory no longer exists, and whose server is not alive. It is a dry
run unless `--apply` is given. Bases created before `.worktree` existed are
never collected; delete them by hand once no server uses them.

`--gc-templates` is separate from `--gc`: it never deletes bases. It retains
symlinks, partial/unknown names, non-matching markers, active templates, and
every current or legacy pin key referenced by any base (including orphans) or
the current worktree. `--apply` requires fresh, exact full-tree external
custody created by `tools/build/template_custody.py` and an approved macOS
mounted-volume UUID.

When stdin is not a terminal (agents, CI), the client runs with TERM=dumb and
stdin from /dev/null so a server started there cannot block on terminal probes.

Environment knobs (defaults in brackets):
  SBT_WARM_HOME   cache root            [~/.cache/scalafim-sbt]
  SBT_WARM_HEAP   server -Xmx            [6g]
  SBT_WARM_CPUS   server processor count [4]
  SBT_WARM_SLOTS  concurrent commands    [3]
  SBT_WARM_IDLE_MINUTES  server idle shutdown [30]
  SBT_WARM_STOP_SECONDS  `--shutdown` client timeout and stop wait [60]
"""

import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import select
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path


HOME = Path(os.environ.get("SBT_WARM_HOME", Path.home() / ".cache" / "scalafim-sbt"))
HEAP = os.environ.get("SBT_WARM_HEAP", "6g")
CPUS = os.environ.get("SBT_WARM_CPUS", "4")
SLOTS = int(os.environ.get("SBT_WARM_SLOTS", "3"))
IDLE_MINUTES = int(os.environ.get("SBT_WARM_IDLE_MINUTES", "30"))
STOP_SECONDS = float(os.environ.get("SBT_WARM_STOP_SECONDS", "60"))

SHA_PATTERN = re.compile(r"\b[0-9a-f]{40}\b")
REPO_PATTERN = re.compile(r"canardlapin/[A-Za-z0-9._-]+")
WORKTREE_RECORD = ".worktree"
LEGACY_PIN_MARKER = ".pin-key"  # compared (and rmtree'd on mismatch) by older scripts
PIN_MARKER = ".pin-key-v2"
STARTUP_RECORD = ".server-startup.json"
# Never copied into a clone: live server sockets and the source base's identity.
CLONE_EXCLUDES = ("server", "command-receipts", WORKTREE_RECORD, STARTUP_RECORD)


class UsageError(Exception):
    pass


def custody_module():
    """Load the sibling script even when this wrapper was imported by tests."""
    path = Path(__file__).with_name("template_custody.py")
    loader = importlib.machinery.SourceFileLoader("template_custody", str(path))
    spec = importlib.util.spec_from_loader("template_custody", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def log(message: str) -> None:
    print(f"[sbt-warm] {message}", file=sys.stderr, flush=True)


def worktree() -> Path:
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
    return Path(out.stdout.strip()).resolve()


def base_for(root: Path) -> Path:
    return HOME / "bases" / hashlib.sha256(str(root).encode()).hexdigest()[:16]


def pin_key(root: Path) -> str:
    """Hash of everything that determines the staged dependency builds.

    Pins are recognised by content, not by line shape: every 40-hex SHA (in
    order of appearance, so a revision split across lines is still seen) and
    the sorted set of canardlapin repositories. Comments and formatting that
    carry neither do not change the key.
    """
    digest = hashlib.sha256()
    text = (root / "build.sbt").read_text()
    for sha in SHA_PATTERN.findall(text):
        digest.update(b"sha:" + sha.encode() + b"\n")
    for repo in sorted(set(REPO_PATTERN.findall(text))):
        digest.update(b"repo:" + repo.encode() + b"\n")
    for name in ("project/build.properties", "project/plugins.sbt"):
        path = root / name
        digest.update(f"file:{name}\n".encode())
        if path.exists():
            digest.update(path.read_bytes())
    return digest.hexdigest()[:16]


def legacy_pin_key(root: Path) -> str:
    """The pre-2026-10-04 pin key, verbatim. Written to `.pin-key` only so that
    older copies of this script, which rmtree a base whose `.pin-key` differs
    from this value, keep finding a match. Do not use it to decide anything."""
    digest = hashlib.sha256()
    build = (root / "build.sbt").read_text().splitlines()
    for line in build:
        if "Revision" in line or "canardlapin/" in line or ".build" in line:
            digest.update(line.strip().encode())
    for name in ("project/build.properties", "project/plugins.sbt"):
        path = root / name
        if path.exists():
            digest.update(path.read_bytes())
    return digest.hexdigest()[:16]


def socket_alive(path: Path) -> bool:
    """True when something accepts connections on the unix socket at `path`.

    Missing or refusing sockets are dead. Any other failure (for example an
    over-long path) is treated as alive, so callers err towards keeping data.
    """
    if not path.exists():
        return False
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(2)
    try:
        probe.connect(str(path))
        return True
    except (ConnectionRefusedError, FileNotFoundError):
        return False
    except OSError as error:
        log(
            f"cannot probe {path} ({error}); treating its server as alive. If no sbt "
            f"server is running there, stop it or delete its base {path.parent.parent.parent} by hand"
        )
        return True
    finally:
        probe.close()


def live_base_sockets(base: Path) -> list:
    return [sock for sock in sorted((base / "server").glob("*/sock")) if socket_alive(sock)]


def base_server_alive(base: Path) -> bool:
    """True when a server is listening on any socket inside `base`."""
    return bool(live_base_sockets(base))


def active_uri(root: Path):
    """An active server URI, or None for missing or malformed records."""
    active = root / "project" / "target" / "active.json"
    try:
        record = json.loads(active.read_text())
        if not isinstance(record, dict):
            return None
        uri = record.get("uri")
        return uri if isinstance(uri, str) and uri else None
    except (OSError, ValueError):
        return None


def server_running(root: Path) -> bool:
    """Conservatively keep an unknown active server; only missing/stale is dead."""
    active = root / "project" / "target" / "active.json"
    if not active.exists():
        return False
    uri = active_uri(root)
    if uri is None:
        return True
    if not uri.startswith("local://"):
        return True
    return socket_alive(Path(uri[len("local://"):]))


def server_alive(root: Path, base: Path) -> bool:
    return server_running(root) or base_server_alive(base)


def requested_config() -> dict:
    return {"heap": HEAP, "cpus": CPUS, "idle_minutes": IDLE_MINUTES}


def server_identity(root: Path):
    """Identity of a usable active Unix socket, including same-path restarts."""
    try:
        uri = active_uri(root)
        if uri is None or not uri.startswith("local://"):
            return None
        path = Path(uri[len("local://"):])
        if not socket_alive(path):
            return None
        info = path.stat()
        if not stat.S_ISSOCK(info.st_mode):
            return None
        return {"uri": uri, "device": info.st_dev, "inode": info.st_ino, "ctime_ns": info.st_ctime_ns}
    except (OSError, ValueError, KeyError, TypeError):
        return None


def read_startup(base: Path):
    try:
        value = json.loads((base / STARTUP_RECORD).read_text())
        if not isinstance(value, dict):
            return None
        if set(value.get("config", {})) != {"heap", "cpus", "idle_minutes"}:
            return None
        if not isinstance(value.get("identity"), dict):
            return None
        return value
    except (OSError, ValueError, TypeError):
        return None


def write_startup(base: Path, config: dict, identity: dict) -> None:
    # Cold startup is exclusive, so no two writers can share this temporary file.
    target = base / STARTUP_RECORD
    temporary = target.with_suffix(".tmp")
    try:
        temporary.write_text(json.dumps({"config": config, "identity": identity}, sort_keys=True) + "\n")
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)


def require_matching_startup(root: Path, base: Path, config: dict) -> None:
    identity = server_identity(root)
    record = read_startup(base)
    if identity is not None and record is not None and record["identity"] == identity:
        if record["config"] == config:
            return
        reason = f"recorded startup {record['config']} differs from requested {config}"
    else:
        reason = f"live server startup configuration is unknown (requested {config})"
    raise RuntimeError(
        f"{reason}; run `python3 tools/build/sbt-warm --shutdown`, then rerun "
        "with the desired SBT_WARM_HEAP, SBT_WARM_CPUS and SBT_WARM_IDLE_MINUTES"
    )


def client_io(env: dict) -> dict:
    """Without a terminal, keep the client from probing one (sbt deadlocks)."""
    if sys.stdin is not None and sys.stdin.isatty():
        return {}
    env["TERM"] = "dumb"
    return {"stdin": subprocess.DEVNULL}


def call_client(root: Path, base: Path, command: str, timeout=None) -> int:
    env = sbt_env(base)
    extra = client_io(env)
    try:
        return subprocess.call(["sbt", "--client", command], cwd=root, env=env, timeout=timeout, **extra)
    except subprocess.TimeoutExpired:
        log(f"`sbt --client {command}` did not return within {timeout:.0f}s")
        return 124


def run_client(root: Path, base: Path, command: str, timeout=None, verify_completion=True) -> int:
    if not verify_completion:
        # Only --shutdown uses this: stop_server verifies that the socket dies.
        return call_client(root, base, command, timeout)
    receipts = base / "command-receipts"
    receipts.mkdir(parents=True, exist_ok=True)
    # Outside the build's target directory so `clean` cannot delete a live receipt.
    # Every invocation owns its directory, including concurrent warm clients.
    with tempfile.TemporaryDirectory(prefix="run-", dir=receipts) as directory:
        receipt = Path(directory) / "completed"
        token = uuid.uuid4().hex
        completion = (
            "eval java.nio.file.Files.write(java.nio.file.Paths.get("
            + json.dumps(str(receipt)) + "), " + json.dumps(token) + '.getBytes("UTF-8"))'
        )
        # One semicolon command keeps the receipt in the same failure-aborting
        # queue. A second client/request could succeed after the first disconnected.
        wrapped = ";" + command.strip().lstrip(";") + ";" + completion
        code = call_client(root, base, wrapped, timeout)
        if code != 0:
            return code
        try:
            completed = receipt.read_text() == token
        except (OSError, ValueError):
            completed = False
        if not completed:
            log(f"{command}: client exited 0 without a valid server completion receipt; command completion is unverified")
            return 1
        return 0


def point_active_json(root: Path, base: Path) -> None:
    """If active.json does not name a live server but the base has one, name it.

    `sbt --client` only consults active.json and starts a fresh server when it
    is missing or stale, so a shutdown would otherwise miss the live server.
    """
    uri = active_uri(root)
    # Keep valid nonlocal URIs conservatively; malformed records can be repaired
    # only when exactly one known base socket supplies the missing identity.
    if uri is not None and (not uri.startswith("local://") or socket_alive(Path(uri[len("local://"):]))):
        return
    live = live_base_sockets(base)
    if len(live) != 1:
        return
    active = root / "project" / "target" / "active.json"
    active.parent.mkdir(parents=True, exist_ok=True)
    log(f"active.json does not name the live server; pointing it at {live[0]}")
    active.write_text(json.dumps({"uri": f"local://{live[0]}"}))


def stop_server(root: Path, base: Path) -> bool:
    """Ask this worktree's server to shut down; True once nothing is alive.

    The caller must hold the worktree lock exclusively and must not hold the
    global bases lock: the client call can take up to STOP_SECONDS.
    """
    if not server_alive(root, base):
        return True
    point_active_json(root, base)
    uri = active_uri(root)
    if uri is None or not uri.startswith("local://") or not server_running(root):
        log(f"the server for {root} cannot be addressed through active.json and {base}; not stopping it or starting a replacement")
        return False
    run_client(root, base, "shutdown", timeout=STOP_SECONDS, verify_completion=False)
    deadline = time.time() + STOP_SECONDS
    while server_alive(root, base):
        if time.time() >= deadline:
            return False
        time.sleep(1)
    return True


def worktree_lock(base: Path):
    """The per-worktree lock file: runs hold it shared, shutdown/gc exclusive."""
    locks = HOME / "locks"
    locks.mkdir(parents=True, exist_ok=True)
    return open(locks / base.name, "a")


def try_exclusive(handle) -> bool:
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def clone_tree(source: Path, target: Path) -> None:
    """Copy `source` to `target` atomically, skipping CLONE_EXCLUDES.

    Uses an APFS copy-on-write clone (`cp -c`) where available and falls back to
    a plain copy otherwise. A failed copy is removed and never renamed into place.
    """
    target.parent.mkdir(parents=True, exist_ok=True)
    staging = target.with_name(target.name + ".partial")
    if staging.exists():
        shutil.rmtree(staging)
    try:
        attempts = []
        if sys.platform == "darwin":
            attempts.append(["cp", "-c", "-R", str(source), str(staging)])
        attempts.append(["cp", "-p", "-R", str(source), str(staging)])
        error = ""
        for index, command in enumerate(attempts):
            result = subprocess.run(command, capture_output=True, text=True)
            if result.returncode == 0:
                break
            error = result.stderr.strip()
            if staging.exists():
                shutil.rmtree(staging)
            if index + 1 < len(attempts):
                log(f"copy-on-write clone failed ({error or 'exit ' + str(result.returncode)}); falling back to a plain copy")
        else:
            raise RuntimeError(f"could not copy {source} to {target}: {error}")
        for name in CLONE_EXCLUDES:
            excluded = staging / name
            if excluded.is_dir() and not excluded.is_symlink():
                shutil.rmtree(excluded)
            elif excluded.exists() or excluded.is_symlink():
                excluded.unlink()
        staging.rename(target)
    except BaseException:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)
        raise


def write_if_changed(path: Path, text: str) -> None:
    if not path.exists() or path.read_text() != text:
        path.write_text(text)


def prepare_base(root: Path):
    """Create or reuse this worktree's base; return (base, pin key).

    Never deletes anything and never calls the sbt client, so the global lock
    is held only for filesystem work.
    """
    key = pin_key(root)
    legacy = legacy_pin_key(root)
    base = base_for(root)
    with open_home_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        marker = base / PIN_MARKER
        if not base.exists():
            seeds = [HOME / "templates" / key, HOME / "templates" / legacy]
            seed = next((template for template in seeds if template.is_dir()), None)
            if seed is not None:
                log(f"seeding base from template {seed.name} (copy-on-write)")
                clone_tree(seed, base)
            else:
                log(f"no template for pins {key}; first build will clone and compile dependencies")
                base.mkdir(parents=True)
        elif marker.exists() and marker.read_text() != key:
            log(f"pins changed for {root}; keeping base {base} (staging is keyed by source revision)")
        write_if_changed(marker, key)
        write_if_changed(base / LEGACY_PIN_MARKER, legacy)
        write_if_changed(base / WORKTREE_RECORD, str(root))
        wanted = f"Global / serverIdleTimeout := Some(scala.concurrent.duration.FiniteDuration({IDLE_MINUTES}L, \"minutes\"))\n"
        write_if_changed(base / "global.sbt", wanted)
    return base, key


def open_home_lock():
    HOME.mkdir(parents=True, exist_ok=True)
    return open(HOME / "bases.lock", "a")


def snapshot_template(base: Path, key: str) -> None:
    template = HOME / "templates" / key
    if template.exists():
        return
    with open_home_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not template.exists():
            log(f"saving pin template {template.name} for future worktrees")
            clone_tree(base, template)


def acquire_slot():
    """Hold one of SLOTS host-wide command slots (counting semaphore)."""
    slots = HOME / "slots"
    slots.mkdir(parents=True, exist_ok=True)
    waited = False
    while True:
        for index in range(SLOTS):
            handle = open(slots / f"slot-{index}", "a")
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                if waited:
                    log(f"acquired slot {index}")
                return handle
            except BlockingIOError:
                handle.close()
        if not waited:
            log(f"all {SLOTS} command slots busy; waiting")
            waited = True
        time.sleep(2)


def sbt_env(base: Path) -> dict:
    env = dict(os.environ)
    env["SBT_OPTS"] = (
        f"-Xmx{HEAP} -XX:ActiveProcessorCount={CPUS} -Dsbt.global.base={base} "
        "-Dsbt.supershell=false -Dsbt.color=false"
    )
    return env


def gc(apply: bool) -> int:
    """Report (or with `apply`, delete) bases whose worktree is gone and server dead."""
    bases = HOME / "bases"
    if not bases.is_dir():
        log("no bases")
        return 0
    removable = []
    with open_home_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for base in sorted(path for path in bases.iterdir() if path.is_dir()):
            record = base / WORKTREE_RECORD
            if not record.is_file():
                print(f"keep    {base.name}  (no worktree record)")
                continue
            recorded = record.read_text().strip()
            if hashlib.sha256(recorded.encode()).hexdigest()[:16] != base.name:
                print(f"keep    {base.name}  (record {recorded} does not match the base name)")
                continue
            if Path(recorded).exists():
                print(f"keep    {base.name}  (worktree {recorded} exists)")
                continue
            if base_server_alive(base):
                # The worktree is gone, so its server cannot be addressed through
                # active.json; its idle timeout stops it and a later --gc collects it.
                print(f"keep    {base.name}  (server alive; worktree {recorded} is gone; retry after it idles out)")
                continue
            removable.append((base, recorded))
            if not apply:
                print(f"remove  {base.name}  (worktree {recorded} is gone)")
                continue
            with worktree_lock(base) as held:
                if not try_exclusive(held):
                    print(f"keep    {base.name}  (an sbt-warm run holds its worktree lock)")
                    continue
                shutil.rmtree(base)
            print(f"removed {base.name}  (worktree {recorded} is gone)")
    if not apply and removable:
        log(f"dry run: {len(removable)} base(s) would be removed; rerun with --gc --apply")
    return 0


TEMPLATE_KEY = re.compile(r"^[0-9a-f]{16}$")


def marker_present(path: Path) -> bool:
    try:
        path.lstat()
        return True
    except FileNotFoundError:
        return False
    except OSError as error:
        raise RuntimeError(f"cannot inspect {path}: {error}") from error


def marker_key(path: Path) -> str:
    """Read a present marker strictly; uncertainty protects every template."""
    try:
        info = path.lstat()
        if not stat.S_ISREG(info.st_mode):
            raise RuntimeError(f"not a regular file: {path}")
        value = path.read_text().strip()
    except OSError as error:
        raise RuntimeError(f"cannot read {path}: {error}") from error
    if not TEMPLATE_KEY.fullmatch(value):
        raise RuntimeError(f"invalid pin key in {path}")
    return value


def protected_template_keys(root: Path) -> set:
    """All base references, including orphaned bases, plus this worktree's keys."""
    protected = {pin_key(root), legacy_pin_key(root)}
    bases = HOME / "bases"
    if not bases.exists():
        return protected
    if bases.is_symlink() or not bases.is_dir():
        raise RuntimeError(f"cannot inspect bases directory {bases}")
    for base in bases.iterdir():
        try:
            info = base.lstat()
        except OSError as error:
            raise RuntimeError(f"cannot inspect base {base}: {error}") from error
        if stat.S_ISLNK(info.st_mode):
            try:
                marker_base = base.resolve(strict=True)
                resolved_info = marker_base.lstat()
            except (OSError, RuntimeError) as error:
                raise RuntimeError(f"cannot resolve symlink base {base}: {error}") from error
            if not stat.S_ISDIR(resolved_info.st_mode):
                raise RuntimeError(f"symlink base {base} does not resolve to a directory")
        elif stat.S_ISDIR(info.st_mode):
            marker_base = base
        else:
            continue
        for marker_name in (PIN_MARKER, LEGACY_PIN_MARKER):
            marker = marker_base / marker_name
            if marker_present(marker):
                protected.add(marker_key(marker))
    return protected


def template_is_active(template: Path) -> tuple[bool, str]:
    """Probe the complete template tree; every diagnostic is retention.

    A plain directory probe misses an open descendant. ``+D`` asks lsof to
    descend the tree. It can be expensive on a large template, hence the hard
    timeout; a timeout, warning, or traversal error is never interpreted as
    inactivity.
    """
    try:
        result = subprocess.run(
            ["lsof", "-Fn", "+D", str(template)], capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError) as error:
        return True, f"activity check unavailable: {error}"
    if getattr(result, "stderr", "").strip():
        return True, "activity check emitted diagnostics"
    # BSD lsof can report found files on stdout yet return 1 after a partial
    # recursive traversal.  A nonempty listing is evidence of activity; only a
    # completely silent clean exit 1 establishes inactivity.
    if getattr(result, "stdout", "").strip():
        return True, "open file reported by lsof"
    if result.returncode == 1:
        return False, "inactive"
    if result.returncode == 0:
        return True, "open file reported by lsof"
    return True, f"activity check failed (lsof exit {result.returncode})"


def lsof_apply_positive_control(templates: Path) -> tuple[bool, str]:
    """Prove lsof can see another process's open descendant before deletion.

    A sandbox or OS privacy policy can make a clean lsof exit look like an
    inactive tree even while files are open.  The apply path creates a private,
    non-candidate directory, then starts a child process which keeps its file
    open while the parent queries with the exact production probe. Diagnostics
    do not count as proof: only lsof's positive open-file result permits
    further work.
    """
    process = None
    try:
        with tempfile.TemporaryDirectory(prefix=".lsof-apply-probe-", dir=templates) as probe_name:
            probe = Path(probe_name)
            child = probe / "open-child"
            child.write_bytes(b"sbt-warm lsof apply positive control\n")
            command = (
                "import sys; "
                "handle = open(sys.argv[1], 'rb'); "
                "print('ready', flush=True); "
                "sys.stdin.readline()"
            )
            process = subprocess.Popen(
                [sys.executable, "-c", command, str(child)],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
            )
            if process.stdout is None or not select.select([process.stdout], [], [], 5)[0]:
                return False, "positive-control child did not become ready"
            if process.stdout.readline().strip() != "ready":
                return False, "positive-control child failed before opening its file"
            active, reason = template_is_active(probe)
            if active and reason == "open file reported by lsof":
                return True, "positive control observed child open descendant"
            return False, f"positive control was not observed ({reason})"
    except (OSError, subprocess.SubprocessError) as error:
        return False, f"cannot run lsof positive control: {error}"
    finally:
        if process is not None:
            try:
                if process.stdin is not None:
                    process.stdin.write("\n")
                    process.stdin.flush()
                    process.stdin.close()
                process.wait(timeout=5)
            except (OSError, subprocess.SubprocessError):
                process.terminate()
                try:
                    process.wait(timeout=5)
                except (OSError, subprocess.SubprocessError):
                    process.kill()
                    process.wait()
            finally:
                for stream in (process.stdout, process.stderr):
                    if stream is not None:
                        stream.close()


def gc_templates(apply: bool, custody_root: Path | None = None, volume_uuid: str | None = None) -> int:
    """Conservative template-only collection; it never calls the base collector."""
    templates = HOME / "templates"
    if not templates.is_dir() or templates.is_symlink():
        log("no safe templates directory")
        return 0
    if apply and (custody_root is None or volume_uuid is None):
        raise UsageError("--gc-templates --apply requires --custody-root DIR and --volume-uuid UUID")
    with open_home_lock() as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if apply:
            observed, reason = lsof_apply_positive_control(templates)
            if not observed:
                log(f"template GC apply refused: {reason}")
                return 1
        try:
            protected = protected_template_keys(worktree())
        except (OSError, RuntimeError) as error:
            log(f"template GC refused: cannot determine protected pin keys: {error}")
            return 1
        for template in sorted(templates.iterdir(), key=lambda path: path.name):
            if not TEMPLATE_KEY.fullmatch(template.name):
                print(f"keep    {template.name}  (not a direct 16-hex template key)")
                continue
            if template.is_symlink() or not template.is_dir():
                print(f"keep    {template.name}  (not a real directory)")
                continue
            matching, unsafe = False, None
            for marker_name in (PIN_MARKER, LEGACY_PIN_MARKER):
                marker = template / marker_name
                try:
                    present = marker_present(marker)
                except RuntimeError as error:
                    unsafe = str(error)
                    break
                if present:
                    try:
                        marker_value = marker_key(marker)
                        matching = matching or marker_value == template.name
                    except RuntimeError as error:
                        unsafe = str(error)
                        break
            if unsafe or not matching:
                print(f"keep    {template.name}  ({unsafe or 'no matching pin marker'})")
                continue
            if template.name in protected:
                print(f"keep    {template.name}  (pin key is referenced by a retained base or current worktree)")
                continue
            active, reason = template_is_active(template)
            if active:
                print(f"keep    {template.name}  ({reason})")
                continue
            if not apply:
                print(f"remove  {template.name}  (unreferenced inactive template; custody required for --apply)")
                continue
            destination = custody_root / template.name
            verified, reason = custody_module().verify_custody(template, destination, HOME, volume_uuid)
            if not verified:
                print(f"keep    {template.name}  (custody not verified: {reason})")
                continue
            try:
                if template.name in protected_template_keys(worktree()):
                    print(f"keep    {template.name}  (became referenced during GC)")
                    continue
            except (OSError, RuntimeError) as error:
                print(f"keep    {template.name}  (cannot recheck pin references: {error})")
                continue
            active, reason = template_is_active(template)
            if active:
                print(f"keep    {template.name}  ({reason})")
                continue
            shutil.rmtree(template)
            print(f"removed {template.name}  (verified external custody at {destination})")
    return 0


def parse(argv: list):
    """Return (mode, payload), keeping GC modes deliberately disjoint."""
    if "--" in argv:
        split = argv.index("--")
        options, commands = argv[:split], argv[split + 1 :]
    else:
        options, commands = argv, []
    leading_commands = []
    custody_root = None
    volume_uuid = None
    flags = []
    index = 0
    while index < len(options):
        arg = options[index]
        if arg in ("--custody-root", "--volume-uuid"):
            if index + 1 == len(options) or options[index + 1].startswith("-"):
                raise UsageError(f"{arg} needs a value")
            if arg == "--custody-root":
                custody_root = Path(options[index + 1])
            else:
                volume_uuid = options[index + 1]
            index += 2
        elif arg.startswith("-"):
            flags.append(arg)
            index += 1
        else:
            leading_commands.append(arg)
            index += 1
    commands = leading_commands + commands
    if "-h" in flags or "--help" in flags:
        return "help", None
    known = {"--status", "--shutdown", "--gc", "--gc-templates", "--apply"}
    unknown = [flag for flag in flags if flag not in known]
    if unknown:
        raise UsageError(f"unknown option(s): {' '.join(unknown)} (put sbt arguments after `--`)")
    if "--apply" in flags and not ({"--gc", "--gc-templates"} & set(flags)):
        raise UsageError("--apply is only valid with --gc or --gc-templates")
    if (custody_root is not None or volume_uuid is not None) and "--gc-templates" not in flags:
        raise UsageError("custody options are only valid with --gc-templates")
    modes = [flag for flag in flags if flag != "--apply"]
    if len(modes) > 1:
        raise UsageError(f"choose one of {', '.join(modes)}")
    if modes:
        if commands:
            raise UsageError(f"{modes[0]} takes no commands")
        mode = modes[0][2:]
        if mode == "gc-templates":
            return mode, ("--apply" in flags, custody_root, volume_uuid)
        return mode, ("--apply" in flags if mode == "gc" else None)
    if not commands:
        raise UsageError("no commands given")
    return "run", commands


def claim_server(root: Path, base: Path, held, config: dict) -> bool:
    """Keep a shared matching server, or acquire exclusive cold startup.

    Never upgrade a shared lock in place: competing cold clients release it
    before waiting for exclusive ownership, then recheck the winner's server.
    True means the caller owns the exclusive lock and must record any startup.
    """
    if server_alive(root, base):
        require_matching_startup(root, base, config)
        return False
    fcntl.flock(held, fcntl.LOCK_UN)
    fcntl.flock(held, fcntl.LOCK_EX)
    if server_alive(root, base):
        require_matching_startup(root, base, config)
        fcntl.flock(held, fcntl.LOCK_SH)
        return False
    (base / STARTUP_RECORD).unlink(missing_ok=True)
    return True


def run(root: Path, commands: list) -> int:
    base = base_for(root)
    config = requested_config()
    with worktree_lock(base) as held:
        fcntl.flock(held, fcntl.LOCK_SH)
        key = None
        code = 0
        slot = None
        try:
            for command in commands:
                cold = claim_server(root, base, held, config)
                if key is None or cold:
                    base, key = prepare_base(root)
                if slot is None:
                    slot = acquire_slot()
                started = time.time()
                code = run_client(root, base, command)
                if cold:
                    identity = server_identity(root)
                    if identity is not None:
                        write_startup(base, config, identity)
                        fcntl.flock(held, fcntl.LOCK_SH)
                log(f"{command}: exit {code} in {time.time() - started:.1f}s")
                if code != 0:
                    break
        finally:
            if slot is not None:
                slot.close()
        # The commands are finished, so this client leaves the server idle. A live
        # server means the build loaded, even if a later command failed. The key
        # is the one the base was prepared with, not a re-read of build.sbt.
        template = HOME / "templates" / key
        if not template.exists() and (base / "staging").exists() and server_running(root):
            snapshot_template(base, key)
        return code


def shutdown(root: Path) -> int:
    base = base_for(root)
    with worktree_lock(base) as held:
        if not try_exclusive(held):
            log(f"sbt-warm commands are running in {root}; not shutting its server down")
            return 1
        if not server_alive(root, base):
            log("no server running")
            return 0
        if stop_server(root, base):
            return 0
        log(f"the server for {root} is still alive after {STOP_SECONDS:.0f}s")
        return 1


def main(argv: list) -> int:
    try:
        mode, payload = parse(argv)
    except UsageError as error:
        print(f"sbt-warm: {error}; see `sbt-warm --help`", file=sys.stderr)
        return 2
    if mode == "help":
        print(__doc__)
        return 0
    if mode == "gc":
        return gc(apply=payload)
    if mode == "gc-templates":
        apply, custody_root, volume_uuid = payload
        try:
            return gc_templates(apply, custody_root, volume_uuid)
        except UsageError as error:
            print(f"sbt-warm: {error}", file=sys.stderr)
            return 2
    root = worktree()
    if mode == "status":
        base = base_for(root)
        key = pin_key(root)
        print(f"worktree {root}\npin key  {key}\nbase     {base} ({'present' if base.exists() else 'absent'})")
        print(f"template {'present' if (HOME / 'templates' / key).exists() else 'absent'}")
        print(f"server   {'running' if server_alive(root, base) else 'not running'}")
        config = requested_config()
        record = read_startup(base)
        identity = server_identity(root)
        trusted = identity is not None and record is not None and record["identity"] == identity
        print(f"requested launch config {json.dumps(config, sort_keys=True)}")
        print(f"recorded startup config {json.dumps(record['config'], sort_keys=True) if trusted else 'unknown (no matching live socket identity)'}")
        print(f"config   {'matches' if trusted and record['config'] == config else 'differs' if trusted else 'unknown'} (requested values, not verified effective JVM flags)")
        return 0
    if mode == "shutdown":
        return shutdown(root)
    try:
        return run(root, payload)
    except RuntimeError as error:
        log(str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
