{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalafim.org/schema/lowrankmodels-oracle-v1.json",
  "title": "ScalaFIM LowRankModels.jl differential fixture",
  "type": "object",
  "required": ["schemaVersion", "provenance", "cases"],
  "properties": {
    "schemaVersion": {
      "const": "scalafim.lowrankmodels.oracle.v1"
    },
    "provenance": {
      "type": "object",
      "required": ["repository", "commit", "juliaVersion", "packageVersion"],
      "properties": {
        "repository": {
          "const": "https://github.com/madeleineudell/LowRankModels.jl.git"
        },
        "commit": {
          "const": "a18f0df45f1a6ce37634bf4e347062b6090397eb"
        },
        "juliaVersion": {"type": "string", "minLength": 1},
        "packageVersion": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/oracleCase"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "number"}
      }
    },
    "mask": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "boolean"}
      }
    },
    "penalty": {
      "type": "object",
      "required": ["kind", "scalaWeight", "juliaScale"],
      "properties": {
        "kind": {"enum": ["none", "l1", "squared-frobenius"]},
        "scalaWeight": {"type": "number", "minimum": 0},
        "juliaScale": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "required": ["observedEntryLoss", "rowPenalty", "decoderPenalty", "total"],
      "properties": {
        "observedEntryLoss": {"type": "number"},
        "rowPenalty": {"type": "number", "minimum": 0},
        "decoderPenalty": {"type": "number", "minimum": 0},
        "total": {"type": "number"},
        "responseConstant": {"type": "number"}
      },
      "additionalProperties": false
    },
    "oracleCase": {
      "type": "object",
      "required": [
        "id",
        "loss",
        "rank",
        "data",
        "observed",
        "rowCodes",
        "decoder",
        "naturalParameters",
        "rowPenalty",
        "decoderPenalty",
        "objective"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "loss": {"enum": ["quadratic", "logistic", "poisson", "categorical"]},
        "levels": {"type": "integer", "minimum": 2},
        "rank": {"type": "integer", "minimum": 1},
        "data": {"$ref": "#/$defs/matrix"},
        "observed": {"$ref": "#/$defs/mask"},
        "rowCodes": {"$ref": "#/$defs/matrix"},
        "decoder": {"$ref": "#/$defs/matrix"},
        "naturalParameters": {
          "type": "array",
          "minItems": 1
        },
        "naturalGradients": {
          "type": "array",
          "minItems": 1
        },
        "decoded": {
          "type": "array",
          "minItems": 1
        },
        "rowPenalty": {"$ref": "#/$defs/penalty"},
        "decoderPenalty": {"$ref": "#/$defs/penalty"},
        "objective": {"$ref": "#/$defs/objective"},
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  }
}
