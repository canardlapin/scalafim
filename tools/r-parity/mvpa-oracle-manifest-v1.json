      "id": "crossvalidated-rdm",
      "estimand": {
        "name": "crossvalidated squared Mahalanobis distance",
        "quantity": "ordered independent-partition contrast inner products",
        "normalization": "raw and divide-by-neural-dimension",
        "fold_reduction": "equal mean over all ordered distinct partition pairs",
        "metadata": {
          "precision_policy": "fixed identity precision",
          "pair_order": "canonical upper triangle a-b,a-c,b-c",
          "signed_null_estimates": true,
          "naive_bias_comparator": "mean within-partition squared distance"
        }
      },
      "axes": [
        {
          "name": "effects",
          "role": "condition order",
          "ordered_keys": [
            "a",
            "b",
            "c"
