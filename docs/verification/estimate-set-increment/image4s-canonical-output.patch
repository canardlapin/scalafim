+      right(Axis.ordinal(s"axis$i", AxisKind.Batch, n))
+    })
+  )
+  private def options(dt: NiftiDatatype) = NiftiWriteOptions
+    .forDatatype(dt)
+    .withIoLimits(NiftiIoLimits.default.copy(workingBufferBytes = 17))
