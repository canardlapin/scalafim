+    private def fill(x: Double, out: ProfileJetBuffer): Unit =
+      out.energy = 1e16 + (x - 0.2) * (x - 0.2) + (if x == 0.0 then 0.0 else 64.0)
+      out.gradient(0) = 2.0 * (x - 0.2)
