diff --git a/modules/fit/shared/src/test/scala/scalafim/fmri/fit/profile/ShapeDecoderTangentSuite.scala b/modules/fit/shared/src/test/scala/scalafim/fmri/fit/profile/ShapeDecoderTangentSuite.scala
