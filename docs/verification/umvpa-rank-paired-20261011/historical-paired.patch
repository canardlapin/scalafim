+package scalafim.fmri.mvpa.inference
+
+import multivar.inference.{Alternative, MonteCarloStopReason, ReplicateProvenance}
+import resample4s.kernel.Seed
+import scalafim.fmri.mvpa.analysis.CalibrationBindings
+import scala.concurrent.duration.*
+
+/** Historical public adapter; only custody and recording are new. Production
+  * remains at edad5bcd with Multivar ab811e2, and contains no copied kernel.
+  */
+class RankHistoricalPairedPilotSuite extends munit.FunSuite:
+  override val munitTimeout: Duration = 15.minutes
+
+  test("opt-in historical paired exploratory cell retains actual seed receipts"):
+    val list = CalibrationPlatform.environment("SCALAFIM_RANK_PAIRED_LIST")
+    assume(list.isDefined, "paired input inventory absent")
+    def required(name: String): String = CalibrationPlatform.environment(name).getOrElse(fail(name + " required"))
+    val output = required("SCALAFIM_RANK_PAIRED_OUTPUT")
+    val commit = required("SCALAFIM_CALIBRATION_SOURCE_COMMIT")
+    assert(commit.matches("[0-9a-f]{40}"))
+    val lockText = CalibrationPlatform.readText(required("SCALAFIM_CALIBRATION_SOURCE_LOCK"))
+    val root = required("SCALAFIM_CALIBRATION_SOURCE_ROOT")
+    val locks = lockText.linesIterator.filter(_.nonEmpty).map: line =>
+      val columns = line.split('\t').toVector
+      assertEquals(columns.length, 2)
+      val path = columns(0)
+      assert(path.nonEmpty && !path.startsWith("/") && !path.contains('\\') &&
+        !path.split('/').exists(p => p == ".." || p == "." || p.isEmpty))
+      assert(columns(1).matches("[0-9a-f]{64}"))
+      path -> columns(1)
+    .toVector
+    assert(locks.nonEmpty)
+    def verifySource(): Unit = locks.foreach: (path, digest) =>
+      assertEquals(CalibrationPlatform.sha256Utf8(CalibrationPlatform.readText(root + "/" + path)), digest)
+    verifySource()
+    val paths = CalibrationPlatform.readText(list.get).linesIterator.filter(_.nonEmpty).toVector
+    assert(paths.nonEmpty)
+    val cases = paths.map: path =>
+      val text = CalibrationPlatform.readText(path)
+      val input = CalibrationProtocolSupport.readCase(text, "scalafim/umvpa/rank-method-comparison/v2").fold(fail(_), identity)
+      input -> CalibrationPlatform.sha256Utf8(text)
+    assert(cases.forall((c, _) => Set("fixture", "pilot").contains(c.phase) && c.draws == 199))
+    assertEquals(cases.map((c, _) => (c.scenario, c.ordinal)).distinct.length, cases.length)
+    if cases.exists((c, _) => c.phase == "pilot") then
+      assertEquals(cases.map((c, _) => c.phase).distinct, Vector("pilot"))
+      assertEquals(cases.map((c, _) => c.scenario).distinct.length, 1)
+      assertEquals(cases.map((c, _) => c.ordinal), (0 until 200).toVector)
+    def quoted(text: String): String = CalibrationProtocolSupport.jsonString(text)
+    cases.foreach: (input, digest) =>
+      val started = System.nanoTime()
+      def prefix = "{\"scenario_id\":" + quoted(input.scenario) + ",\"phase\":" + quoted(input.phase) +
+        ",\"dataset_index\":" + input.ordinal + ",\"root_seed64\":\"" + input.rootSeed +
+        "\",\"rank_method\":\"historical-euclidean-coefficient-permutation/ab811e257dd67f77e8c3b70cb1ea600f274429a3\"" +
+        ",\"elapsed_seconds\":" + ((System.nanoTime() - started) / 1e9) +
+        ",\"source_commit\":" + quoted(commit) + ",\"source_lock_sha256\":" + quoted(CalibrationPlatform.sha256Utf8(lockText)) +
+        ",\"case_input_sha256\":" + quoted(digest)
+      val record = CalibrationProtocolSupport.retainEvaluation(prefix):
+        CalibrationBindings.rank(input.x, input.y, input.nuisance, input.rootSeed, input.draws, input.scenario, input.ordinal).map: result =>
+          val arithmetic = result.candidateArithmetic
+          val receipts = arithmetic.receipts
+          val resampling = CalibrationProtocolSupport.child(input.rootSeed, 103, 0).fold(fail(_), identity)
+          val algorithm = "canonical-rank-distinct-nonidentity/v1"
+          assertEquals(receipts.length, input.populationCorrelations.length)
+          assertEquals(arithmetic.completedCompactFits, 199L * receipts.length)
+          receipts.foreach: receipt =>
+            assert(receipt.observed.isFinite)
+            assertEquals(receipt.allocated.value, 199)
+            assertEquals(receipt.consumed.value, 199)
+            assertEquals(receipt.stopReason, MonteCarloStopReason.Exhausted)
+            assertEquals(receipt.alternative, Alternative.Greater)
+            receipt.provenance match
+              case ReplicateProvenance.Deterministic(seed, actual, derivation) =>
+                assertEquals(seed.value, resampling)
+                assertEquals(actual.value, algorithm)
+                assertEquals(derivation, Seed.derivationAlgorithm)
+              case ReplicateProvenance.External => fail("unbound historical receipt")
+          val metrics = CalibrationProtocolSupport.rankMetrics(receipts.map(_.pValue.value),
+            arithmetic.adjustedPValues.map(_.value), receipts.map(_.exceedances), input.draws).fold(fail(_), identity)
+          assert(result.admittedDetectableRank.isLeft)
+          prefix + ",\"status\":\"evaluated\",\"completed_draws\":199,\"residual_rows\":" + result.residualRows +
+            ",\"planned_owned_cells\":" + result.plannedOwnedCells + ",\"completed_compact_fits\":" +
+            arithmetic.completedCompactFits + ",\"observed_roots\":[" + arithmetic.correlations.mkString(",") +
+            "],\"provenance_version\":1,\"seed_receipts_verified\":true,\"receipt_seed64\":[" +
+            receipts.map(_ => quoted(resampling.toString)).mkString(",") + "],\"receipt_algorithm\":" + quoted(algorithm) +
+            ",\"observed_statistics\":[" + receipts.map(_.observed).mkString(",") + "]" + metrics.jsonFields + "}\n"
+      verifySource()
+      CalibrationPlatform.appendText(output, record)
