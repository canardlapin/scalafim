+def run_client(root: Path, base: Path, command: str, timeout=None, verify_completion=True) -> int:
+    if not verify_completion:
+        # Only --shutdown uses this: stop_server verifies that the socket dies.
+        return call_client(root, base, command, timeout)
+    receipts = base / "command-receipts"
+    receipts.mkdir(parents=True, exist_ok=True)
+    # Outside the build's target directory so `clean` cannot delete a live receipt.
+    # Every invocation owns its directory, including concurrent warm clients.
+    with tempfile.TemporaryDirectory(prefix="run-", dir=receipts) as directory:
+        receipt = Path(directory) / "completed"
+        token = uuid.uuid4().hex
+        completion = (
+            "eval java.nio.file.Files.write(java.nio.file.Paths.get("
+            + json.dumps(str(receipt)) + "), " + json.dumps(token) + '.getBytes("UTF-8"))'
+        )
+        # One semicolon command keeps the receipt in the same failure-aborting
+        # queue. A second client/request could succeed after the first disconnected.
+        wrapped = ";" + command.strip().lstrip(";") + ";" + completion
+        code = call_client(root, base, wrapped, timeout)
+        if code != 0:
+            return code
+        try:
+            completed = receipt.read_text() == token
+        except (OSError, ValueError):
+            completed = False
+        if not completed:
+            log(f"{command}: client exited 0 without a valid server completion receipt; command completion is unverified")
+            return 1
+        return 0
+
