diff --git a/modules/mvpa/shared/src/test/scala/scalafim/fmri/mvpa/inference/RankHistoricalResourceProbeSuite.scala b/modules/mvpa/shared/src/test/scala/scalafim/fmri/mvpa/inference/RankHistoricalResourceProbeSuite.scala
