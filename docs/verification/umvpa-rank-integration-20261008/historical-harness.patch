+#!/usr/bin/env python3
+"""Freeze replay of eight retained inputs against unchanged historical production."""
+import hashlib
+import json
+import subprocess
+from pathlib import Path
+
+packet=Path(__file__).resolve().parent
+root=packet.parents[2]
+baseline='edad5bcd65f7ba004458a6dd08c5fb3a31a3e6d3'
+allowed={
+ 'modules/mvpa/shared/src/test/scala/scalafim/fmri/mvpa/inference/CalibrationProtocolSupport.scala',
+ 'modules/mvpa/shared/src/test/scala/scalafim/fmri/mvpa/inference/CalibrationProtocolSuite.scala'}
+changed=set(subprocess.check_output(['git','diff',baseline,'--name-only'],cwd=root,text=True).splitlines())
+assert changed<=allowed,changed
+files=subprocess.check_output(['git','ls-files','modules/mvpa','modules/scenario-testkit','build.sbt',
+ '.jvmopts','project/build.properties','project/plugins.sbt','tools/build/sbt-warm',
+ 'tools/mvpa-inference/calibration_protocol.py','tools/mvpa-inference/run_calibration.py',
+ 'tools/mvpa-inference/run_rank_pilot.py'],cwd=root,text=True).splitlines()
+files += ['modules/mvpa/shared/src/test/scala/scalafim/fmri/mvpa/inference/RankHistoricalResourceProbeSuite.scala']
+files += [str(p.relative_to(root)) for p in packet.glob('*.py')]
+sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+original=json.loads((packet/'original-probe-manifest.json').read_text())
+manifest=dict(status='source-frozen-retained-fixture-replay-only',historical_consumer_baseline=baseline,
+ provider_revision='ab811e257dd67f77e8c3b70cb1ea600f274429a3',
+ method_identity='historical-euclidean-coefficient-permutation/ab811e257dd67f77e8c3b70cb1ea600f274429a3',
+ cells=original['cells'],new_datasets=0,retained_datasets=8,expected_records=8,
+ input_archive_sha256=sha(packet/'retained-inputs.tar.gz'),
+ inputs=json.loads((packet/'retained-input-sha256.json').read_text()),
+ resampling_seed='Unchanged historical child(root, custom-domain 103, ordinal 0); shared with the repaired permutation comparator.',
+ production_unchanged_from_baseline=True,
+ source_locks={p:sha(root/p) for p in sorted(set(files))},
+ limits=dict(worker_processes=1,cpus=4,heap='3g',max_wall_seconds=900,max_rss_bytes=4*1024**3),
+ scientific_qualification=False,pilot_or_confirmation_consumed=False)
+with (packet/'historical-manifest.json').open('x') as out:out.write(json.dumps(manifest,indent=2)+'\n')
+print(json.dumps(dict(sources=len(manifest['source_locks']),cases=8,new_datasets=0)))
