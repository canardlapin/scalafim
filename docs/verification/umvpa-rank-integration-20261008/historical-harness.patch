@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Replay retained fixtures once; never generate or replace a dataset."""
+import datetime
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+import tarfile
+from pathlib import Path
+
+packet=Path(__file__).resolve().parent
+root=packet.parents[2]
+sys.path.insert(0,str(root/'tools/mvpa-inference'))
+from run_rank_pilot import monitor
+sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
+manifest=json.loads((packet/'historical-manifest.json').read_text())
+assert manifest['status']=='source-frozen-retained-fixture-replay-only'
+for p,expected in manifest['source_locks'].items():assert sha(root/p)==expected,p
+assert subprocess.check_output(['git','show','HEAD:'+str((packet/'historical-manifest.json').relative_to(root))],cwd=root)==(packet/'historical-manifest.json').read_bytes()
+assert sha(packet/'retained-inputs.tar.gz')==manifest['input_archive_sha256']
+out=packet/'historical-probe';out.mkdir(exist_ok=False)
+vm=subprocess.check_output(['vm_stat'],text=True)
+page=int(re.search(r'page size of (\d+) bytes',vm).group(1))
+pages={name:int(value) for name,value in re.findall(r'^([^:]+):\s+(\d+)\.',vm,re.M)}
+available=sum(pages.get(name,0) for name in ('Pages free','Pages inactive','Pages speculative'))*page
+host=dict(utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+ physical_memory_bytes=int(subprocess.check_output(['sysctl','-n','hw.memsize'],text=True)),
+ free_inactive_speculative_bytes=available,required_headroom_bytes=8*1024**3)
+(out/'host-before.json').write_text(json.dumps(host,indent=2)+'\n')
+assert available>=8*1024**3,'insufficient host headroom; no replay performed'
+inputs=out/'inputs';inputs.mkdir()
+with tarfile.open(packet/'retained-inputs.tar.gz','r:gz') as archive:
+    assert set(archive.getnames())==set(manifest['inputs'])
+    for name,expected in manifest['inputs'].items():
+        assert Path(name).name==name
+        data=archive.extractfile(name).read()
+        assert hashlib.sha256(data).hexdigest()==expected
+        with (inputs/name).open('xb') as stream:stream.write(data)
+paths=[inputs/(c['id']+'.tsv') for c in manifest['cells']]
+(out/'case-files.txt').write_text(''.join(str(p)+'\n' for p in paths))
+env=dict(os.environ,SBT_WARM_HEAP='3g',SBT_WARM_CPUS='4',LC_ALL='C',LANG='C',
+ SCALAFIM_RANK_HISTORICAL_PROBE_LIST=str(out/'case-files.txt'),
+ SCALAFIM_RANK_HISTORICAL_PROBE_OUTPUT=str(out/'records.jsonl'))
+for key in ['JAVA_TOOL_OPTIONS','JDK_JAVA_OPTIONS','SBT_OPTS','JAVA_OPTS']:env.pop(key,None)
+with (out/'server-lifecycle.log').open('x') as log:
+    subprocess.run(['python3','tools/build/sbt-warm','--shutdown'],cwd=root,env=env,
+        stdout=log,stderr=subprocess.STDOUT,timeout=65,check=True)
+command=['python3','tools/build/sbt-warm','mvpaJVM/testOnly scalafim.fmri.mvpa.inference.RankHistoricalResourceProbeSuite']
+with (out/'worker.log').open('x') as log:receipt=monitor(root,command,env,log,manifest['limits'])
+records=[json.loads(line) for line in (out/'records.jsonl').read_text().splitlines()] if (out/'records.jsonl').exists() else []
+receipt.update(source_commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip(),
+ provider_revision=manifest['provider_revision'],new_datasets=0,records=len(records),
+ all_assignments_completed=len(records)==8 and {r['scenario_id'] for r in records}=={c['id'] for c in manifest['cells']},
+ evaluated=sum(r.get('status')=='evaluated' for r in records),
+ source_locks_unchanged=all(sha(root/p)==expected for p,expected in manifest['source_locks'].items()),
+ limits=manifest['limits'],scientific_qualification=False)
+(out/'process-receipt.json').write_text(json.dumps(receipt,indent=2)+'\n')
+print(json.dumps(receipt))
+assert receipt['worker_exit']==0 and not receipt['resource_refusal'] and receipt['all_assignments_completed'] and receipt['evaluated']==8 and receipt['source_locks_unchanged']
